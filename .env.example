# Navidrome instance the MCP server talks to (as reachable from inside the container)
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change-me

# Bearer token MCP clients must send: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# MCP_PORT=8000
# NAVIDROME_TIMEOUT=30
